<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Bitácora Financiera</title>
    <style>
        body, html { 
            margin: 0; 
            padding: 0; 
            height: 100%; 
            overflow: hidden; 
            background: #0f172a; 
        }
        iframe { 
            width: 100%; 
            height: calc(100% + 120px); /* Aumenta la altura para compensar el desplazamiento */
            margin-top: -120px;         /* Desplaza el iframe hacia arriba para ocultar el banner */
            border: none; 
            display: block; 
        }
    </style>
</head>
<body>
    <!-- Reemplaza la URL por la de tu implementación de Apps Script -->
